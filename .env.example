TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
BOT_PASSWORD=

# Optional. Maximum Telegram upload size in MB. Defaults to 10; capped at 50.
# MAX_UPLOAD_MB=10

# Optional universal group document-monitor limits. Values are MB except counts.
# MAX_IMAGE_MB=10
# MAX_PDF_MB=20
# MAX_DOCUMENT_MB=15
# MAX_SPREADSHEET_MB=15
# MAX_PRESENTATION_MB=20
# MAX_ARCHIVE_MB=20
# MAX_PDF_PAGES_FOR_VISION=3
# MAX_PRESENTATION_SLIDES_FOR_VISION=3
# MAX_ARCHIVE_FILES=50
# MAX_ARCHIVE_EXTRACTED_MB=50

# Optional. Per-job Codex timeout in milliseconds. Defaults to 180000 (3 minutes).
# CODEX_JOB_TIMEOUT_MS=180000

# Optional. Defaults to the repository root.
# CODEX_WORKDIR=/absolute/path/to/project

# Optional. Defaults to ./data. Point this to a persistent Render disk if used.
# ASHRAF_AI_DATA_DIR=/absolute/path/to/data

# Render production: writable persistent Codex home with existing ChatGPT login.
# CODEX_HOME=/var/data/codex
# Optional: seed auth.json once from a Render Secret File (never overwrite refreshes).
# CODEX_AUTH_FILE=/etc/secrets/auth.json
# PORT is provided automatically by Render.

# Optional. Username used for owner mentions in groups (without @).
# TELEGRAM_BOT_USERNAME=Ashraf8765_bot
# ALLOWED_TELEGRAM_USER_ID must be set for owner group activation.
