TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_ID=
BOT_PASSWORD=

# Optional. Maximum Telegram upload size in MB. Defaults to 10; capped at 50.
# MAX_UPLOAD_MB=10

# Optional. Per-job Codex timeout in milliseconds. Defaults to 180000 (3 minutes).
# CODEX_JOB_TIMEOUT_MS=180000

# Optional. Defaults to the repository root.
# CODEX_WORKDIR=/absolute/path/to/project

# Optional. Defaults to ./data. Point this to a persistent Render disk if used.
# ASHRAF_AI_DATA_DIR=/absolute/path/to/data
